{
  "name": "@boost-relay/mezo",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Mezo data layer and exact BoostVoter math",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formatting": {
      "types": "./dist/formatting.d.ts",
      "import": "./dist/formatting.js"
    },
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "import": "./dist/abis/index.js"
    },
    "./chains": {
      "types": "./dist/config/chains.d.ts",
      "import": "./dist/config/chains.js"
    },
    "./addresses": {
      "types": "./dist/config/addresses.d.ts",
      "import": "./dist/config/addresses.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "viem": "^2.57.10"
